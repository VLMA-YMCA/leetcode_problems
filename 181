def find_employees(employee: pd.DataFrame) -> pd.DataFrame:
    rich_employees = pd.DataFrame({'Employee': []})
    for id in employee['id']:
        if not pd.isna(employee.loc[employee['id'] == id, 'managerId'].values[0]):
            workers_name = employee.loc[employee['id'] == id, 'name'].values[0]
            workers_salary = employee.loc[employee['id'] == id, 'salary'].values[0]
            managers_id = employee.loc[employee['id'] == id, 'managerId'].values[0]
            if not employee[employee['id'] == managers_id].empty:
                managers_salary = employee.loc[employee['id'] == managers_id, 'salary'].values[0]
                if workers_salary > managers_salary:
                    new_burgoise = pd.DataFrame({'Employee': [workers_name]})  
                    rich_employees = pd.concat([rich_employees, new_burgoise], ignore_index=True)
    return rich_employees


